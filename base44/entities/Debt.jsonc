{
  "name": "Debt",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "current_balance": {
      "type": "number"
    },
    "original_balance": {
      "type": "number"
    },
    "interest_rate": {
      "type": "number"
    },
    "interest_type": {
      "type": "string",
      "enum": [
        "APR",
        "Fixed",
        "Variable",
        "Simple",
        "Compound",
        "None"
      ],
      "default": "APR",
      "description": "The type of interest rate for this liability"
    },
    "minimum_payment": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paid_off"
      ],
      "default": "active"
    },
    "show_in_accounts": {
      "type": "boolean",
      "default": false,
      "description": "Whether this debt is surfaced in the Accounts section"
    }
  },
  "required": [
    "name",
    "current_balance"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}