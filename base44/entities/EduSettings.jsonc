{
  "name": "EduSettings",
  "type": "object",
  "properties": {
    "scholarship_threshold_gpa": {
      "type": "number",
      "description": "GPA floor to keep scholarship; alert if cumulative drops below"
    },
    "weekly_sleep_hours": {
      "type": "number",
      "default": 56,
      "description": "Weekly hours reserved for sleep (used by work-study balance)"
    },
    "google_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether Google Calendar is connected"
    },
    "calendar_id": {
      "type": "string",
      "description": "Google Calendar ID of the 'EduSync - Academic Schedule' secondary calendar"
    },
    "calendar_email": {
      "type": "string",
      "description": "Email of the connected Google account"
    },
    "daily_study_goal": {
      "type": "number",
      "default": 120,
      "description": "Target study minutes per day"
    },
    "push_classes": {
      "type": "boolean",
      "default": true,
      "description": "Push class schedules to calendar"
    },
    "push_assignments": {
      "type": "boolean",
      "default": true,
      "description": "Push assignment deadlines to calendar"
    },
    "push_exams": {
      "type": "boolean",
      "default": true,
      "description": "Push exam dates to calendar"
    },
    "detect_conflicts": {
      "type": "boolean",
      "default": true,
      "description": "Auto-detect calendar conflicts when scheduling study sessions"
    },
    "transcript": {
      "type": "object",
      "description": "Parsed academic transcript snapshot: courses, cumulative GPA, credits, quality points, per-term and major breakdown"
    },
    "task_types": {
      "type": "array",
      "description": "Custom task type definitions used when adding focus tasks. Each item: { name: string, color: string }",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "nav_items": {
      "type": "array",
      "description": "Customized navigation bar order \u2014 array of EduSync page identifiers. Pages not in this array go under the 'More' dropdown.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}