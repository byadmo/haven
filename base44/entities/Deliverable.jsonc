{
  "name": "Deliverable",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "The Course this deliverable belongs to (null for a free/no-course task)"
    },
    "title": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string",
      "description": "Optional time portion for a scheduled task (HH:MM 24h). Stored separately from due_date so the date picker stays a pure date."
    },
    "weight": {
      "type": "number",
      "default": 0,
      "description": "Weight as percentage of final grade (0-100)"
    },
    "type": {
      "type": "string",
      "default": "other",
      "description": "Task type label \u2014 free-form string so it accepts the same task types used in Settings (Reading, Studying, Homework, Project, Exam Prep, ...). Legacy values (assignment, quiz, midterm, exam, project, lab, other) still valid."
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "submitted",
        "graded"
      ],
      "default": "not_started",
      "description": "Workflow status of the deliverable"
    },
    "grade": {
      "type": "number",
      "description": "Achieved percentage (0-100). Null until graded."
    },
    "max_grade": {
      "type": "number",
      "default": 100
    },
    "is_exam": {
      "type": "boolean",
      "default": false
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "graded": {
      "type": "boolean",
      "default": false
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar event id once this deliverable has been synced. Used to update (not duplicate) the event on re-sync."
    }
  },
  "required": [
    "course_id",
    "title",
    "due_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}