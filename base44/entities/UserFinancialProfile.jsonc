{
  "name": "UserFinancialProfile",
  "type": "object",
  "properties": {
    "income_type": {
      "type": "string",
      "enum": [
        "fixed",
        "variable"
      ],
      "default": "fixed"
    },
    "baseline_monthly_income": {
      "type": "number",
      "default": 0
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "conservative",
        "moderate",
        "aggressive"
      ],
      "default": "moderate"
    },
    "emergency_buffer_target": {
      "type": "number",
      "default": 2000
    },
    "monthly_discretionary_limit": {
      "type": "number",
      "default": 500
    },
    "trailing_3m_min_income": {
      "type": "number",
      "default": 0
    },
    "last_adaptation_date": {
      "type": "string",
      "format": "date"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "nav_items": {
      "type": "array",
      "description": "Customized navigation bar order \u2014 array of Finance page identifiers. Pages not in this array go under the 'More' dropdown.",
      "items": {
        "type": "string"
      }
    },
    "theme": {
      "type": "string",
      "default": "midnight",
      "description": "Selected Haven Finance theme key (midnight, daylight, cottonCandy, forest, sunset)."
    },
    "ai_auto_detect_bills": {
      "type": "boolean",
      "default": true,
      "description": "Whether AI auto-detection scans transactions for recurring bills and subscriptions."
    },
    "base_income": {
      "type": "number",
      "default": 0,
      "description": "User's gross/net pay per pay period (amount of one paycheque)."
    },
    "income_frequency": {
      "type": "string",
      "enum": [
        "Weekly",
        "Bi-Weekly",
        "Monthly"
      ],
      "default": "Bi-Weekly",
      "description": "How often the user is paid \u2014 drives per-paycheque bill requirements."
    },
    "pay_day": {
      "type": "number",
      "description": "Day the paycheque lands: 1-31 for Monthly, 1-7 (Mon-Sun) for Weekly/Bi-Weekly."
    }
  },
  "required": [
    "income_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}