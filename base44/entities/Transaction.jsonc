{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "is_scheduled": {
      "type": "boolean",
      "default": false
    },
    "frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "weekly",
        "monthly"
      ],
      "default": "one_time"
    },
    "next_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "description",
    "amount",
    "type",
    "date"
  ]
}