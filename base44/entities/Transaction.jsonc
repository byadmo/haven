{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "is_scheduled": {
      "type": "boolean",
      "default": false
    },
    "frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "daily",
        "weekly",
        "biweekly",
        "monthly",
        "yearly",
        "custom"
      ],
      "default": "one_time"
    },
    "custom_interval": {
      "type": "number",
      "description": "When frequency is 'custom', the number of units between occurrences"
    },
    "custom_unit": {
      "type": "string",
      "enum": [
        "days",
        "weeks",
        "months",
        "years"
      ],
      "description": "When frequency is 'custom', the unit for custom_interval"
    },
    "next_date": {
      "type": "string",
      "format": "date"
    },
    "account_id": {
      "type": "string",
      "description": "The Account this transaction pays into (income) or out of (expense)"
    },
    "transfer_account_id": {
      "type": "string",
      "description": "The paired account in a transfer: the opposite side of account_id (FROM for income, TO for expense)"
    },
    "dup_keep_hash": {
      "type": "string",
      "description": "Unique id assigned to every transaction in a duplicate group the user chose to keep as legitimate; matching groups are suppressed from future duplicate detection"
    },
    "is_tax_deductible": {
      "type": "boolean",
      "default": false,
      "description": "Whether this transaction is tax-deductible (tracked for the annual tax summary)"
    },
    "recurring_suppressed": {
      "type": "boolean",
      "default": false,
      "description": "When true the user has stopped this transaction from appearing in the Upcoming & Recurring section. The recurring auto-scan skips it so it will never be re-surfaced, even on re-runs."
    }
  },
  "required": [
    "description",
    "amount",
    "type",
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}