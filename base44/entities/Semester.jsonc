{
  "name": "Semester",
  "type": "object",
  "properties": {
    "term_type": {
      "type": "string",
      "enum": [
        "fall",
        "winter",
        "spring_summer"
      ],
      "default": "fall",
      "description": "Detected academic term"
    },
    "term_label": {
      "type": "string",
      "description": "Display label e.g. Fall 2026"
    },
    "year": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "term_label",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}