{
  "name": "CourseCatalogCache",
  "type": "object",
  "properties": {
    "cache_key": {
      "type": "string",
      "description": "Normalized 'university_name::faculty::degree_program' lookup key (lowercased, trimmed) used to find the shared cache record for a combo."
    },
    "university_name": {
      "type": "string",
      "description": "The Canadian university this catalog cache is for."
    },
    "faculty": {
      "type": "string",
      "description": "Faculty / school the cached degree program belongs to, e.g. 'Faculty of Engineering'."
    },
    "degree_program": {
      "type": "string",
      "description": "Degree program the cached courses belong to, e.g. 'Electrical Engineering'."
    },
    "track_type": {
      "type": "string",
      "description": "Program track these requirements belong to, e.g. 'Full-Time, Four-Year Program'."
    },
    "calendar_source_url": {
      "type": "string",
      "description": "The exact undergraduate academic calendar / course listing URL that was parsed to build this cache."
    },
    "parsed_courses": {
      "type": "array",
      "description": "All courses parsed from the university's course catalog for this faculty + degree program.",
      "items": {
        "type": "object",
        "properties": {
          "course_code": {
            "type": "string"
          },
          "course_title": {
            "type": "string"
          },
          "course_description": {
            "type": "string"
          },
          "credits": {
            "type": "number"
          },
          "prerequisites": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "difficulty_hints": {
            "type": "string"
          },
          "difficulty": {
            "type": "object",
            "description": "Deterministic Course Workload & Complexity Score (CWCS) computed during parsing \u2014 no LLM overhead.",
            "properties": {
              "score": {
                "type": "number",
                "description": "1.0\u201310.0 clamped complexity score (one decimal)."
              },
              "label": {
                "type": "string",
                "description": "Workload band: 'Introductory / Low Workload' | 'Standard / Moderate Workload' | 'Advanced / High Workload' | 'Intensive / Capstone Level'."
              },
              "hasLab": {
                "type": "boolean",
                "description": "True when the course description mentions a lab(/laboratory) component."
              }
            }
          }
        },
        "required": [
          "course_code",
          "course_title"
        ]
      }
    },
    "curriculum": {
      "type": "array",
      "description": "Degree requirements extracted for the track_type: course codes mapped by year and term.",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "string"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "term": {
                  "type": "string"
                },
                "courses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "difficulty": {
                        "type": "object",
                        "description": "Deterministic CWCS score carried into the curriculum so cache-hit responses include it.",
                        "properties": {
                          "score": {
                            "type": "number"
                          },
                          "label": {
                            "type": "string"
                          },
                          "hasLab": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "required": [
                      "code"
                    ]
                  }
                }
              },
              "required": [
                "term"
              ]
            }
          }
        },
        "required": [
          "year"
        ]
      }
    },
    "last_parsed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last successful parse of this catalog."
    },
    "parse_status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Outcome of the last parse: success (clean), partial (low confidence / some courses), failed (no courses extracted)."
    },
    "parse_notes": {
      "type": "string",
      "description": "Any issues encountered while parsing, e.g. 'could not find calendar page, used AI fallback'."
    }
  },
  "required": [
    "university_name",
    "parse_status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}