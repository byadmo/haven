{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "deck_id": {
      "type": "string",
      "description": "Link to FlashcardDeck"
    },
    "front": {
      "type": "string",
      "description": "Question or term on the front of the card"
    },
    "back": {
      "type": "string",
      "description": "Answer or definition on the back of the card"
    },
    "easiness": {
      "type": "number",
      "default": 2.5,
      "description": "SM-2 easiness factor (min 1.3)"
    },
    "interval": {
      "type": "number",
      "default": 0,
      "description": "SM-2 interval in days"
    },
    "repetitions": {
      "type": "number",
      "default": 0,
      "description": "SM-2 consecutive correct answers count"
    },
    "next_review": {
      "type": "string",
      "format": "date",
      "description": "Date of next scheduled review (ISO date)"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last review"
    },
    "hint": {
      "type": "string",
      "description": "Optional hint shown during review"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags for filtering cards"
    }
  },
  "required": ["deck_id", "front", "back"],
  "rls": {
    "read": { "created_by_id": "{{user.id}}" },
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" }
  }
}