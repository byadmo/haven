{
  "name": "AccountAlert",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Reference to the Account being monitored"
    },
    "threshold_type": {
      "type": "string",
      "enum": [
        "minimum_balance",
        "percentage_drop"
      ]
    },
    "threshold_value": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "account_id",
    "threshold_type",
    "threshold_value"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}