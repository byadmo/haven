{
  "name": "Course",
  "type": "object",
  "properties": {
    "semester_id": {
      "type": "string",
      "description": "The Semester this course belongs to"
    },
    "code": {
      "type": "string",
      "description": "Course code e.g. CSC110"
    },
    "title": {
      "type": "string"
    },
    "professor_name": {
      "type": "string"
    },
    "professor_email": {
      "type": "string"
    },
    "office_hours": {
      "type": "string"
    },
    "schedule_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Day abbreviations: M, T, W, Th, F, S, Su"
    },
    "schedule_time": {
      "type": "string",
      "description": "e.g. 10:00-11:30"
    },
    "location": {
      "type": "string"
    },
    "target_weekly_hours": {
      "type": "number",
      "default": 6
    },
    "credits": {
      "type": "number",
      "default": 3
    },
    "color": {
      "type": "string",
      "default": "emerald"
    },
    "university_name": {
      "type": "string",
      "description": "University this course belongs to (inherited from profile, overridable per course)."
    },
    "course_description": {
      "type": "string",
      "description": "Course description pulled from the university course catalog."
    },
    "faculty": {
      "type": "string",
      "description": "Faculty / department offering the course (e.g. Faculty of Engineering)."
    },
    "degree_program": {
      "type": "string",
      "description": "Degree program the course belongs to (e.g. Electrical Engineering)."
    },
    "specialization": {
      "type": "string",
      "description": "Specialization / specialty within the degree program."
    },
    "prerequisites": {
      "type": "string",
      "description": "Prerequisite courses (free-form text from the catalog)."
    },
    "difficulty_ranking": {
      "type": "string",
      "enum": [
        "Easy",
        "Moderate",
        "Hard",
        "Very Hard",
        "Brutal"
      ],
      "description": "AI-assessed difficulty ranking for the course (Easy \u2192 Moderate \u2192 Hard \u2192 Very Hard \u2192 Brutal)."
    },
    "difficulty_reason": {
      "type": "string",
      "description": "Short explanation shown next to the difficulty ranking."
    },
    "difficulty_details": {
      "type": "string",
      "description": "Full AI-generated explanation of the course difficulty (cached, shown on Learn More)."
    }
  },
  "required": [
    "semester_id",
    "code",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}