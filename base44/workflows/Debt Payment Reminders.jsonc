{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/Toronto",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends an email reminder each morning for any debt payment due within the next 3 days.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "debt_payment_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "SendDebtReminders",
            "args": {
              "lead_days": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send debt reminders",
            "description": "Email upcoming due payments"
          }
        }
      }
    ]
  },
  "name": "Debt Payment Reminders"
}